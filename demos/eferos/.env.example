# URL pública donde se despliega la web (sin barra final). Se usa en canonical, sitemap y Open Graph.
# Si se deja vacía se usa el dominio de Vercel/Railway, o http://localhost:3000 en local.
# Poner https://www.eferos.es solo cuando la web se publique en el dominio del cliente.
NEXT_PUBLIC_SITE_URL=

# Mientras sea una demo comercial, dejar en "false" para no competir en Google con la web real de Eferos.
# Cambiar a "true" solo cuando esta web sustituya a la actual en producción.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Reseñas de Google (Places API, New). Solo servidor: no usar el prefijo NEXT_PUBLIC_.
# Sin estas dos variables la web no muestra reseñas, solo un enlace a Google Maps.
# GOOGLE_PLACES_API_KEY: clave de Google Cloud restringida a "Places API (New)", con cuota diaria limitada.
# GOOGLE_PLACE_ID: identificador de la ficha de Eferos en Google Maps (empieza por "ChIJ...").
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Reserva online (motor de reservas de AvanttAI). Solo servidor: no usar el prefijo NEXT_PUBLIC_.
# La web llama a /api/reservas (mismo dominio) y su servidor reenvía a AvanttAI.
# AVANTTAI_BOOKING_API_URL: URL base de AvanttAI, sin barra final. En pruebas, la de TEST en Railway;
#   https://avanttai.com solo cuando se active en producción.
# AVANTTAI_BOOKING_SLUG: slug público de Eferos en AvanttAI (Reservas online → Tu enlace público).
# Sin estas dos variables, /reservas muestra WhatsApp y teléfono en lugar del formulario.
AVANTTAI_BOOKING_API_URL=
AVANTTAI_BOOKING_SLUG=

# Protección exclusiva para RAILWAY_ENVIRONMENT_NAME=preview:
# Debe coincidir exactamente con el origen HTTPS de la API de TEST verificada.
# Sin este valor o ante una coincidencia con producción, /api/reservas devuelve 503.
# NO usar avanttai.com ni URLs de Railway en su environment productivo.
# Aprobar el destino solo tras verificar que Core, Auth, Vault y Stripe son TEST.
AVANTTAI_BOOKING_PREVIEW_APPROVED_TEST_ORIGIN=

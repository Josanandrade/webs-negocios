# Supabase (Project Settings → API). La clave publicable es segura en el navegador:
# la seguridad real la aplican las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (enlaces de email y redirecciones detrás del proxy de Railway).
SITE_URL=https://lemonrx.example.com

# Supabase (Project Settings → API). La clave publicable es segura en el navegador:
# la seguridad real la aplican las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (enlaces de email y redirecciones detrás del proxy de Railway).
SITE_URL=https://lemonrx.example.com

# Aviso por email al publicar una semana (opcional). Clave de Resend exclusiva
# de Lemon RX y remitente de un dominio verificado en Resend. Sin ellas no se avisa.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Lemon RX <programacion@tu-dominio.com>"

# Notificaciones al móvil de los admins cuando alguien se registra (opcional).
# Claves: npx web-push generate-vapid-keys. PUSH_SECRET: texto aleatorio largo;
# su hash va en private.push_secret de Supabase.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SECRET=

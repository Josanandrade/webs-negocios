# Conexión de la API y el worker: rol SIN BYPASSRLS, miembro de banco_app.
DATABASE_URL=postgresql+psycopg://banco_api:banco_api@localhost:5432/banco
# Conexión del propietario del esquema (solo para migraciones).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/banco
# Secreto para firmar los JWT (genera uno largo y aleatorio).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Orígenes de la web autorizados (separados por comas).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=150

# IA — "proveedor:modelo" por tarea (gemini | anthropic | openai | ollama).
# Por defecto: plan gratuito de Gemini (clave en https://aistudio.google.com).
# Tras la coma, modelos de reserva si el principal está saturado (503) o sin cuota.
# El verificador nunca usa un modelo de la lista del generador.
GEMINI_API_KEY=
LLM_EXTRACTION=gemini:gemini-flash-lite-latest,gemini:gemini-3.1-flash-lite
LLM_GENERATION=gemini:gemini-flash-lite-latest,gemini:gemini-3.1-flash-lite
LLM_VERIFICATION=gemini:gemini-flash-latest,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,gemini:gemini-3.7-flash
LLM_REQUESTS_PER_MINUTE=8
